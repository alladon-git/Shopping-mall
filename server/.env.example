PORT=5000
NODE_ENV=development

# MongoDB (로컬 개발용)
MONGO_URI=mongodb://localhost:27017/shopping-mall

# MongoDB Atlas (프로덕션용)
MONGODB_ATLAS_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopping-mall

# JWT — 32자 이상의 랜덤 hex 문자열 권장
JWT_SECRET=<your_random_secret>

# CORS — 프론트엔드 배포 URL
CLIENT_URL=https://your-app.vercel.app

# 포트원 (iamport) REST API
IMP_KEY=<your_imp_key>
IMP_SECRET=<your_imp_secret>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
